# Copy to .env.local and fill in. Anything blank simply stays off —
# the app degrades gracefully rather than breaking.

# ── Supabase (required for real accounts) ──
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Planning Center (optional) ──
# Personal Access Token from https://api.planningcenteronline.com/oauth/applications
# Server-only — never exposed to the browser.
PCO_APP_ID=
PCO_SECRET=

# ── Web push notifications (optional) ──
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key is safe in the browser; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Email notifications (optional) ──
# Resend API key + a verified sender address.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Used in notification links.
NEXT_PUBLIC_SITE_URL=https://hillcrest-hub.vercel.app

# ── Notification sender (server-only, required to DELIVER notifications) ──
# Supabase service role key. Never commit this and never expose it to the
# browser — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
